# ============================================================
# 21 — бот-хост: переменные окружения
# ============================================================
# ЭТО ШАБЛОН С ЗАГЛУШКАМИ — его коммитить БЕЗОПАСНО.
#
# Как пользоваться:
#   cp .env.example .env      # .env в .gitignore, в репозиторий не попадёт
#   # вписать реальные значения в .env
#   node http-wrapper.js      # сервер сам прочитает .env
#
# Переменные, заданные в окружении хостинга, имеют приоритет над .env —
# на проде удобнее задавать их в панели хостинга, а не файлом.
#
# ПРАВИЛО: реальные токены живут ТОЛЬКО в .env или в панели хостинга.
# Никогда не вписывайте их в этот файл и не пересылайте в переписке.
# ============================================================


# ── Обязательное ─────────────────────────────────────────────

# Токен Telegram-бота. Получить: @BotFather → /newbot (или /token у существующего).
# Без него админ-функции и релей /api/bot выключены (сервер стартует, но пишет "bot relay: OFF").
TELEGRAM_BOT_TOKEN=0000000000:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Порт. Многие хостинги подставляют свой автоматически — тогда строку можно убрать.
PORT=8080


# ── TON API (кошелёк района: баланс, история донатов) ────────

# Ключ tonapi.io для релея /api/tonapi. Получить: https://tonconsole.com → API keys.
# Ключ читает ТОЛЬКО сервер и подставляет в заголовок Authorization;
# в браузер и в клиентский бандл он не попадает.
# Необязателен: без него релей работает на бесплатном лимите tonapi.
TONAPI_KEY=AXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# База TON API. Менять нужно разве что для тестового стенда.
# TONAPI_BASE=https://tonapi.io


# ── Необязательное ───────────────────────────────────────────

# CORS: домен фронтенда, если он на ДРУГОМ хосте (например, GitHub Pages).
# На одном origin не нужно. По умолчанию '*'.
# BOT_ALLOW_ORIGIN=https://username.github.io

# Чат, куда бот шлёт события модерации (заявки, выплаты).
# По умолчанию берётся ADMIN_CHAT из index.html.
# BOT_ADMIN_CHAT=100000000

# Чат сообщества — для счётчика «человек в сообществе» в шапке приложения.
# Бот должен состоять в этом чате. Формат: -100xxxxxxxxxx или @username.
# BOT_STATS_CHAT=-1000000000000

# Кошелёк выплат GRAM: адрес показывается в разделе «Фонд».
# TON_PAYOUT_ADDRESS=UQxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Ключ toncenter.com — нужен только чтобы показывать баланс кошелька выплат.
# TONCENTER_API_KEY=

# Внешняя команда для авто-отправки GRAM: вызывается как CMD "<адрес>" <сумма>.
# Пусто = выплаты вручную (модератор открывает ссылку ton:// сам).
# TON_SEND_CMD=
