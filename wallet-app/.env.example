# ── Кошелёк района: настройки клиента ──
# Все VITE_* попадают в браузерный бандл. Секретов здесь быть НЕ должно:
# ключ TON API живёт на бот-хосте в переменной TONAPI_KEY (см. README).

# Адрес фонда — получатель донатов
VITE_FUND_ADDRESS=UQC1xYc4aPgMaHjER3xZPRKz4LfYgDyNSBSxykZmB2YbsWLW

# URL манифеста TON Connect. По умолчанию берётся рядом с index.html.
# Задавайте, только если манифест лежит на другом домене.
# VITE_MANIFEST_URL=https://example.com/tonconnect-manifest.json

# База TON API. По умолчанию '/api/tonapi' — релей на том же origin (http-wrapper.js).
# Если фронтенд и бот-хост на РАЗНЫХ доменах — укажите полный URL релея:
# VITE_TONAPI_BASE=https://ваш-бот-хост/api/tonapi

# Куда вернуть пользователя после подтверждения в кошельке
VITE_TWA_RETURN_URL=https://t.me/twentyonemovementbot/app
